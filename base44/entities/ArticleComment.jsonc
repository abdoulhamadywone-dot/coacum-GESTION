{
  "name": "ArticleComment",
  "type": "object",
  "properties": {
    "article_id": {
      "type": "string",
      "title": "Article ID"
    },
    "contenu": {
      "type": "string",
      "title": "Commentaire"
    },
    "auteur_nom": {
      "type": "string",
      "title": "Auteur"
    }
  },
  "required": [
    "article_id",
    "contenu"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}