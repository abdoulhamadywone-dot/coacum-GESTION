{
  "name": "Membre",
  "type": "object",
  "properties": {
    "nom": {
      "type": "string",
      "title": "Nom"
    },
    "statut": {
      "type": "string",
      "title": "Statut",
      "enum": [
        "actif",
        "inactif"
      ],
      "default": "actif"
    },
    "date_adhesion": {
      "type": "string",
      "format": "date",
      "title": "Date d'adh\u00e9sion"
    },
    "telephone": {
      "type": "string",
      "title": "T\u00e9l\u00e9phone"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "nom_utilisateur": {
      "type": "string",
      "title": "Nom d'utilisateur"
    },
    "mot_de_passe": {
      "type": "string",
      "title": "Mot de passe"
    },
    "photo_profil": {
      "type": "string",
      "title": "Photo de profil"
    },
    "photo_couverture": {
      "type": "string",
      "title": "Photo de couverture"
    },
    "statut_perso": {
      "type": "string",
      "title": "Statut personnel"
    },
    "description": {
      "type": "string",
      "title": "Description"
    }
  },
  "required": [
    "nom"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}