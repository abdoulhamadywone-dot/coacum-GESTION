{
  "name": "Article",
  "type": "object",
  "properties": {
    "titre": {
      "type": "string",
      "title": "Titre"
    },
    "contenu": {
      "type": "string",
      "title": "Contenu"
    },
    "image_url": {
      "type": "string",
      "title": "Image"
    },
    "document_url": {
      "type": "string",
      "title": "Document"
    },
    "document_nom": {
      "type": "string",
      "title": "Nom du document"
    },
    "auteur": {
      "type": "string",
      "title": "Auteur"
    },
    "categorie": {
      "type": "string",
      "title": "Cat\u00e9gorie",
      "enum": [
        "Annonce",
        "\u00c9v\u00e9nement",
        "Activit\u00e9",
        "Communiqu\u00e9",
        "Culture",
        "Membre"
      ],
      "default": "Annonce"
    },
    "statut": {
      "type": "string",
      "title": "Statut",
      "enum": [
        "brouillon",
        "publi\u00e9"
      ],
      "default": "brouillon"
    },
    "date_publication": {
      "type": "string",
      "format": "date",
      "title": "Date de publication"
    }
  },
  "required": [
    "titre",
    "contenu"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}