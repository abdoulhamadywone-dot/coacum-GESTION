{
  "name": "Participation",
  "type": "object",
  "properties": {
    "membre_id": {
      "type": "string",
      "title": "ID Membre"
    },
    "membre_nom": {
      "type": "string",
      "title": "Nom du membre"
    },
    "evenement_id": {
      "type": "string",
      "title": "ID \u00c9v\u00e9nement"
    },
    "evenement_titre": {
      "type": "string",
      "title": "Titre de l'\u00e9v\u00e9nement"
    },
    "statut": {
      "type": "string",
      "title": "Statut",
      "enum": [
        "pr\u00e9sent",
        "absent",
        "excus\u00e9"
      ],
      "default": "pr\u00e9sent"
    }
  },
  "required": [
    "membre_id",
    "membre_nom",
    "evenement_id",
    "evenement_titre"
  ]
}